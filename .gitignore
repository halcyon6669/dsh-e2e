# Runtime output. Reports belong next to the machine that ran them, not in the
# repository: they carry host names, ports and captured response bodies.
reports/
*.log

# Nothing here is built, but a stray install would be noise.
node_modules/
package-lock.json
pnpm-lock.yaml

# Scratch files the probes write and delete; anything left over was a crash.
# The redesign kept a few `dev/_*.txt` / `.css` / `.json` around as splice
# sources and extracted theme blocks — none of them are deliverables.
dev/_*
dev/.reload-state/
*.tmp-*
*.check-*

# `npm run preview` output: real screenshots and the HTML they came from.
# They are per-machine evidence, not source.
dev/preview/

# Editors and the OS.
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.swp
dev/.commit-msg.txt
